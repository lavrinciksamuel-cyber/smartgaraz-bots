# =============================================================================
# PRIHLASOVACIE ÚDAJE STAČIA — API NIE JE POVINNÉ
# =============================================================================
# Skutočné heslá dávaj LEN do bot/.env (gitignorované), nie sem.
#
# --- Tempo crawlu ---
CRAWL_DELAY=0.4

# --- CENOTVORBA (secret crawler) ---
# SmartGaráž NIE JE platca DPH — nakupujeme s DPH (nevrátiteľná), predávame
# BEZ ďalšieho DPH navrch. COST_HAS_VAT musí byť 1, inak sa DPH pripočíta
# dvakrát a ceny budú nafúknuté.
MARGIN_PERCENT=35
OIL_MARGIN_PERCENT=20
SHIPPING_FLAT=0.60
PRICE_ENDING=0.90
MIN_MARGIN_EUR=1.50
COST_HAS_VAT=1
VAT_RATE=0.00

# --- Metabond partner ---
# METABOND_USER=
# METABOND_PASSWORD=
# METABOND_LOGIN_URL=https://partner.metabond.sk/partner/login

# --- Pro-Tec ---
# PROTEC_USER=
# PROTEC_PASSWORD=
# PROTEC_LOGIN_URL=https://www.pro-tec-slovakia.sk/login/
# PROTEC_MIN_ORDER_EUR=15

# --- JLM (jlmaditiva.sk / AWD Auto) — Shoptet XML feed (hash v secrets) ---
# JLM_FEED_URL=https://www.jlmaditiva.sk/export/productsMarketing.xml?...
# JLM_COST_RATIO=0.80


# --- Würth (Intershop) — default PUBLIC bez loginu ---
# B2B ceny: WURTH_B2B=1 + USER/PASSWORD
# WURTH_B2B=0
# WURTH_USER=
# WURTH_PASSWORD=
# WURTH_LOGIN_URL=https://eshop.wurth.sk/sk/SK/EUR/login
# Voliteľné: čiarkou oddelené category URL (inak auto-relevantné seed-y)
# WURTH_CATEGORY_URL=https://eshop.wurth.sk/Produktove-kategorie/Cistic-strojov-a-dielov/3143300707.cyid/3143.cgid/sk/SK/EUR/

# --- LKQ ---
# SPA vyžaduje login na produkty; bez USER/PASSWORD soft-fail (0 URL).
# VAG / Stellantis / Renault–Nissan → radšej --supplier szekop (public).
# LKQ_USER=
# LKQ_PASSWORD=
# Voliteľné: iná kategória na crawlovanie (inak default = motorové oleje)
# LKQ_CATEGORY_URL=https://www.lkq.sk/Catalog/...

# --- Szekop — default PUBLIC (VAG/Stellantis/RN diely bez loginu) ---
# SZEKOP_B2B=0
# SZEKOP_CATEGORY_URL=

# --- SmartGaráž search insights (WP option sg_insights_key po deployi 1.5.0) ---
# SG_INSIGHTS_KEY=

